{
  "name": "volante",
  "version": "1.0.0",
  "description": "One local MCP endpoint that connects your AI apps to every MCP server you use.",
  "author": "BE Aesthetics",
  "license": "MIT",
  "productName": "Volante",
  "main": "./out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "dist": "electron-vite build && electron-builder --win --config electron-builder.yml --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --config electron-builder.yml --publish never",
    "icons": "electron scripts/make-icons.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "iconoir-react": "^7.12.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "electron@44.4.5": true
  }
}
